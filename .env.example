# Nothing here is needed by default: the collection is kept on the phone (see docs/local-mode.md).
# Set to 1 for the cloud build: Supabase data and email sign-in. Then the two Supabase values below are required.
EXPO_PUBLIC_CLOUD=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Set to 1 to show the Ask tab and the tray (cloud build only; needs the `recommend` Edge Function).
EXPO_PUBLIC_FEATURE_ASK=
