EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Set to 1 to show the Ask tab and the tray (needs the `recommend` Edge Function).
EXPO_PUBLIC_FEATURE_ASK=
# Set to 1 to keep the collection on the phone: no Supabase, no sign-in, file backup in Settings (see docs/local-mode.md).
EXPO_PUBLIC_LOCAL_MODE=
